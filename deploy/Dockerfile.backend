FROM golang:1.26.10-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Версия для страницы «Система»: .git в контекст сборки не попадает, поэтому её передают аргументом
# (docker-compose.yml берёт DIARY_VERSION, например вывод git describe --tags --always).
ARG VERSION=dev
# server и worker — основные процессы; healthcheck нужен для проверки готовности;
# bootstrap-admin и seed — одноразовые утилиты (seed отказывается работать вне development).
RUN for cmd in server worker healthcheck bootstrap-admin seed; do \
      CGO_ENABLED=0 GOOS=linux go build -trimpath \
        -ldflags="-s -w -X schooldiarysvu/internal/buildinfo.Version=${VERSION}" -o /out/$cmd ./cmd/$cmd || exit 1; \
    done
# Каталог для приватных файлов создаётся здесь, чтобы новый именованный том наследовал владельца nonroot (65532).
RUN mkdir -p /out-data/files

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/ /app/
COPY --from=build --chown=65532:65532 /out-data/ /data/
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/app/server"]
